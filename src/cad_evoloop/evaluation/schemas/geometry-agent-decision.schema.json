{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evocad.dev/schemas/geometry-agent-decision.schema.json",
  "title": "EvoCAD Geometry Iteration Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "failure_owner", "observed_failures", "root_causes",
    "structure_assessment", "can_improve", "decision", "decision_reason",
    "planned_geometry_changes", "system_change_proposal", "expected_score_gain", "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "failure_owner": {
      "enum": ["drawing", "prompt", "skill", "task", "mcp", "verifier", "harness", "none"]
    },
    "observed_failures": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 20
    },
    "root_causes": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 20
    },
    "structure_assessment": {"type": "string", "minLength": 1, "maxLength": 4000},
    "can_improve": {"type": "boolean"},
    "decision": {"enum": ["continue", "stop"]},
    "decision_reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "planned_geometry_changes": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 30
    },
    "system_change_proposal": {"type": ["string", "null"], "maxLength": 4000},
    "expected_score_gain": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
