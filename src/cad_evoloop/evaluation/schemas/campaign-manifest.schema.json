{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-evoloop.dev/schemas/campaign-manifest.schema.json",
  "title": "CAD-EvoLoop campaign manifest",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "mode",
    "created_at",
    "dataset",
    "models",
    "execution",
    "source",
    "samples",
    "environment",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["development", "pilot", "frozen-evaluation"]},
    "created_at": {"type": "string"},
    "dataset": {"type": "object"},
    "models": {"type": "array", "minItems": 1},
    "execution": {"type": "object"},
    "source": {"type": "object"},
    "samples": {"type": "array", "minItems": 1},
    "environment": {"type": "object"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
