{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticcae.local/schemas/cad-visual-verdict-1.0.json",
  "title": "CAD Visual Rubric Verdict",
  "type": "object",
  "required": ["image_quality", "rubrics", "global_notes"],
  "properties": {
    "image_quality": {
      "enum": ["sufficient", "insufficient"]
    },
    "rubrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "confidence", "explanation", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "verdict": {"enum": ["pass", "fail", "uncertain"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["image", "description", "region"],
              "properties": {
                "image": {"type": "string"},
                "description": {"type": "string"},
                "region": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": {"type": "number", "minimum": 0, "maximum": 1},
                    "y": {"type": "number", "minimum": 0, "maximum": 1},
                    "width": {"type": "number", "minimum": 0, "maximum": 1},
                    "height": {"type": "number", "minimum": 0, "maximum": 1}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "global_notes": {"type": "string"}
  },
  "additionalProperties": false
}
