# Kimi Code reads this experiment through the in-memory KIMI_MODEL_* channel.
# Fill the first two values in .env. Do not commit the real key.
KIMI_MODEL_BASE_URL=
KIMI_MODEL_API_KEY=

# Kimi Code + K3 defaults used by this experiment.
KIMI_MODEL_NAME=kimi-k3
KIMI_MODEL_PROVIDER_TYPE=kimi
KIMI_MODEL_MAX_CONTEXT_SIZE=1048576
KIMI_MODEL_CAPABILITIES=image_in,video_in,thinking,always_thinking,tool_use
KIMI_MODEL_THINKING_EFFORT=max
